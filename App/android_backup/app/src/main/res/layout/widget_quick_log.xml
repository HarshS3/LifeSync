<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widgetQuickLogRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_card_background"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="12dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Quick Log"
    android:textColor="#F7FAFC"
    android:textSize="16sp"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/widgetQuickLogChat"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:background="@drawable/widget_primary_action_background"
      android:gravity="center"
      android:text="Chat"
      android:textColor="#07110F"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widgetQuickLogVoice"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:background="@drawable/widget_primary_action_background"
      android:gravity="center"
      android:text="Voice"
      android:textColor="#07110F"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widgetQuickLogMeal"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:background="@drawable/widget_action_background"
      android:gravity="center"
      android:text="Meal"
      android:textColor="#DDE5EC"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widgetQuickLogWorkout"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="6dp"
      android:layout_weight="1"
      android:background="@drawable/widget_action_background"
      android:gravity="center"
      android:text="Train"
      android:textColor="#DDE5EC"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widgetQuickLogWellness"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/widget_action_background"
      android:gravity="center"
      android:text="Mood"
      android:textColor="#DDE5EC"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
