{
  "name": "lifesync",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "App",
    "client",
    "server",
    "scraping"
  ],
  "scripts": {
    "dev:app": "npm run start --workspace App",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build:client": "npm run build --workspace client",
    "eas-build-pre-install": "npm install --workspace App",
    "types": "npm run types --workspaces --if-present"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "expo-router": "~4.0.22"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-svg": "15.12.1"
  },
  "dependencies": {
    "expo-dev-client": "~6.0.21"
  }
}
