<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widgetDashboardRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_card_background"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today"
        android:textColor="#F7FAFC"
        android:textSize="18sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/widgetUpdatedAt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Open LifeSync to sync"
        android:textColor="#9AA6B2"
        android:textSize="11sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/widgetReadiness"
      android:layout_width="52dp"
      android:layout_height="52dp"
      android:background="@drawable/widget_primary_action_background"
      android:gravity="center"
      android:text="--"
      android:textColor="#07110F"
      android:textSize="20sp"
      android:textStyle="bold" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="12dp"
    android:layout_weight="1"
    android:orientation="horizontal">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="8dp"
      android:layout_weight="1"
      android:background="@drawable/widget_metric_background"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:padding="10dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calories"
        android:textColor="#9AA6B2"
        android:textSize="11sp" />

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/widgetCalories"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="--"
          android:textColor="#F7FAFC"
          android:textSize="22sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/widgetCalorieTarget"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="3dp"
          android:layout_marginBottom="3dp"
          android:text="/ 2000 kcal"
          android:textColor="#9AA6B2"
          android:textSize="10sp" />
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/widget_metric_background"
      android:gravity="center_vertical"
      android:orientation="vertical"
      android:padding="10dp">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Protein"
        android:textColor="#9AA6B2"
        android:textSize="11sp" />

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/widgetProtein"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="--g"
          android:textColor="#F7FAFC"
          android:textSize="22sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/widgetProteinTarget"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="3dp"
          android:layout_marginBottom="3dp"
          android:text="/ 150g"
          android:textColor="#9AA6B2"
          android:textSize="10sp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/widgetWorkout"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="8dp"
      android:layout_weight="1"
      android:background="@drawable/widget_action_background"
      android:gravity="center"
      android:text="Not started"
      android:textColor="#DDE5EC"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widgetDashboardLogMeal"
      android:layout_width="68dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="8dp"
      android:background="@drawable/widget_action_background"
      android:gravity="center"
      android:text="Meal"
      android:textColor="#DDE5EC"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widgetDashboardWorkout"
      android:layout_width="76dp"
      android:layout_height="match_parent"
      android:layout_marginEnd="8dp"
      android:background="@drawable/widget_action_background"
      android:gravity="center"
      android:text="Workout"
      android:textColor="#DDE5EC"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widgetDashboardChat"
      android:layout_width="72dp"
      android:layout_height="match_parent"
      android:background="@drawable/widget_primary_action_background"
      android:gravity="center"
      android:text="Ask"
      android:textColor="#07110F"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
